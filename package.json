{
  "type": "module",
  "name": "reyhaneh.dev",
  "version": "1.0.0",
  "scripts": {
    "serve": "vite serve --port 3001 --open http://localhost:3001",
    "build": "pnpm pre-push && vite build",
    "preview": "vite preview --port 3002 --open http://localhost:3002",
    "lint": "eslint --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,jsonc,html,css,markdown}\"",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm format && pnpm lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@html-eslint/eslint-plugin": "^0.64.0",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vite-plugin-checker": "^0.14.4"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.0.0"
  }
}
