{
  // ── Save pipeline ─────────────────────────────────────────
  // 1) ESLint autofix (includes import-x/order from eslint.config.js)
  // 2) TypeScript removes unused imports
  // 3) Prettier formats (user setting: editor.formatOnSave + esbenp.prettier-vscode)
  // Do NOT enable source.organizeImports — it fights import-x/order.
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.removeUnusedImports": "explicit",
    "source.organizeImports": "never"
  },

  // ── Match .prettierrc ─────────────────────────────────────
  // tabWidth: 2, useTabs: false, printWidth: 60
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [60],

  // Keep Prettier as formatter for languages this project edits
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    // Avoid mangling Markdown hard line breaks / lists
    "files.trimTrailingWhitespace": false
  },

  // ── ESLint (flat config — ESLint 10) ─────────────────────
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json",
    "jsonc",
    "html",
    "css",
    "markdown"
  ],

  // ── TypeScript — use this project's typescript package ───
  // Unified js/ts.* settings
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,

  // ── Package manager ──────────────────────────────────────
  "npm.packageManager": "pnpm",

  // ── File hygiene (team / Git-friendly) ───────────────────
  "files.eol": "\r\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/routeTree.gen.ts": true
  },
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "git.replaceTagsWhenPull": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/pnpm-lock.yaml": true,
    "**/routeTree.gen.ts": true
  },

  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  }
}
