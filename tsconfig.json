{
  "compilerOptions": {
    // Projects
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",

    // Module Resolution
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },

    // Language And Environment
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "extends": ["./tsconfig.base.json"]
}
